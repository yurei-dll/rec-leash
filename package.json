{
  "name": "rec-leash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firefox-first WebExtension that marks watched YouTube recommendations using local history.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "package:firefox": "npm run build && node scripts/package-firefox.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/jsdom": "^21.1.7",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0"
  }
}
